# PostgreSQL connection. TimescaleDB extension is used if available; falls
# back to plain tables otherwise (see alembic/env.py).
DATABASE_URL=postgresql+psycopg://cse_alpha:cse_alpha@localhost:5432/cse_alpha

# Master Spec Part O #1 — capital base. Drives liquidity gate thresholds and
# position caps. See PARAMETERS.md.
CAPITAL_BASE_LKR=25000000

# cse.lk client politeness settings (Master Spec §5)
CSE_MIN_SECONDS_BETWEEN_CALLS=2.0
CSE_USER_AGENT=cse-alpha-engine/0.1 (personal research use; contact: set-your-email@example.com)

ENVIRONMENT=development
LOG_LEVEL=INFO
