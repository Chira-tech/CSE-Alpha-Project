__pycache__/
*.pyc
.venv/
venv/
.env
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
node_modules/
frontend/dist/
.DS_Store
*.log
.coverage
htmlcov/

# frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/*.tsbuildinfo

# local sqlite dbs used for smoke-testing (real deployment is Postgres)
*.db
*.sqlite
*.sqlite3
*.db-journal
# WAL mode's own auxiliary files (app/db/session.py sets PRAGMA
# journal_mode=WAL for every sqlite connection — see that file's own
# comment) — *.sqlite above doesn't match these suffixes.
*.sqlite-wal
*.sqlite-shm

# isolated git worktrees created for parallel agent sessions
.claude/worktrees/
# Claude Code local session state (locks, transient task output)
.claude/

# runtime-generated artifacts: automatic DB backups and job/server logs
backend/backups/
backend/logs/

# scratch files (one-off PDFs pulled down while tracing an extraction bug)
scratch_*
# resumable-sweep checkpoints — regenerated on every run, the final
# .md report next to them is the real audit artifact
docs/audits/*.partial.jsonl
# bulk raw market-data exports used by scripts/ingest_manual_price_history.py
# — hundreds of MB of xlsx, kept on disk locally, never in git
docs/price data/
